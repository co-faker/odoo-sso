<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access Token List View -->
    <record id="view_sso_access_token_list" model="ir.ui.view">
        <field name="name">sso.access.token.list</field>
        <field name="model">sso.access.token</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="token"/>
                <field name="application_id"/>
                <field name="user_id"/>
                <field name="scope"/>
                <field name="expires_at"/>
                <field name="refresh_expires_at"/>
                <field name="revoked" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Access Token Action -->
    <record id="action_sso_access_token" model="ir.actions.act_window">
        <field name="name">Access Tokens</field>
        <field name="res_model">sso.access.token</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No access tokens yet
            </p>
            <p>
                Access tokens are issued to third-party applications after
                successful authorization. They can be manually revoked if needed.
            </p>
        </field>
    </record>
</odoo>
