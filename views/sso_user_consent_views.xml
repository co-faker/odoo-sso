<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User Consent List View -->
    <record id="view_sso_user_consent_list" model="ir.ui.view">
        <field name="name">sso.user.consent.list</field>
        <field name="model">sso.user.consent</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="user_id"/>
                <field name="application_id"/>
                <field name="scope"/>
                <field name="granted_date"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <!-- User Consent Action -->
    <record id="action_sso_user_consent" model="ir.actions.act_window">
        <field name="name">User Consents</field>
        <field name="res_model">sso.user.consent</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No user consents yet
            </p>
            <p>
                User consents record which users have authorized which applications.
                Consents can be revoked to force re-authorization.
            </p>
        </field>
    </record>
</odoo>
