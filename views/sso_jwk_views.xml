<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SSO JWK List View -->
    <record id="view_sso_jwk_list" model="ir.ui.view">
        <field name="name">sso.jwk.list</field>
        <field name="model">sso.jwk</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="algorithm"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- SSO JWK Form View -->
    <record id="view_sso_jwk_form" model="ir.ui.view">
        <field name="name">sso.jwk.form</field>
        <field name="model">sso.jwk</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="algorithm" readonly="1"/>
                        <field name="active" readonly="1"/>
                    </group>
                    <group string="Public Key (JWKS)">
                        <field name="public_key" nolabel="1" readonly="1" widget="textarea"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SSO JWK Action -->
    <record id="action_sso_jwk" model="ir.actions.act_window">
        <field name="name">OIDC Signing Keys</field>
        <field name="res_model">sso.jwk</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
