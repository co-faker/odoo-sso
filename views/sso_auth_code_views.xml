<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Auth Code List View -->
    <record id="view_sso_auth_code_list" model="ir.ui.view">
        <field name="name">sso.auth.code.list</field>
        <field name="model">sso.auth.code</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="code"/>
                <field name="application_id"/>
                <field name="user_id"/>
                <field name="scope"/>
                <field name="expires_at"/>
                <field name="used" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Auth Code Action -->
    <record id="action_sso_auth_code" model="ir.actions.act_window">
        <field name="name">Authorization Codes</field>
        <field name="res_model">sso.auth.code</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No authorization codes yet
            </p>
            <p>
                Authorization codes are temporary codes generated during the
                OAuth2 authorization flow. They are automatically cleaned up
                after use or expiration.
            </p>
        </field>
    </record>
</odoo>
