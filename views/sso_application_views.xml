<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SSO Application List View -->
    <record id="view_sso_application_list" model="ir.ui.view">
        <field name="name">sso.application.list</field>
        <field name="model">sso.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="approval_prompt"/>
                <field name="access_token_validity"/>
                <field name="refresh_token_validity"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- SSO Application Form View -->
    <record id="view_sso_application_form" model="ir.ui.view">
        <field name="name">sso.application.form</field>
        <field name="model">sso.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_secret"
                                type="object"
                                string="Generate New Secret"
                                class="oe_stat_button"
                                icon="fa-key"/>
                    </div>
                    <widget name="web_ribbon" title="Inactive" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="client_id"/>
                            <field name="client_secret_plain"
                                   invisible="not client_secret_plain"
                                   readonly="1"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="approval_prompt"/>
                            <field name="consent_expiry"/>
                            <field name="scope"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="redirect_uris" string="Redirect URIs">
                            <field name="redirect_uri_ids">
                                <list editable="bottom">
                                    <field name="uri"/>
                                </list>
                            </field>
                        </page>
                        <page name="token_settings" string="Token Settings">
                            <group>
                                <group string="Access Token">
                                    <field name="access_token_validity"/>
                                </group>
                                <group string="Refresh Token">
                                    <field name="refresh_token_validity"/>
                                </group>
                                <group string="ID Token (OIDC)">
                                    <field name="id_token_validity"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SSO Application Search View -->
    <record id="view_sso_application_search" model="ir.ui.view">
        <field name="name">sso.application.search</field>
        <field name="model">sso.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="approval_auto" string="Auto Approval" domain="[('approval_prompt', '=', 'auto')]"/>
                <filter name="approval_force" string="Force Approval" domain="[('approval_prompt', '=', 'force')]"/>
            </search>
        </field>
    </record>

    <!-- SSO Application Action -->
    <record id="action_sso_application" model="ir.actions.act_window">
        <field name="name">SSO Applications</field>
        <field name="res_model">sso.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sso_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first SSO application
            </p>
            <p>
                SSO applications are third-party services that can authenticate
                users through Odoo's OAuth2 provider.
            </p>
        </field>
    </record>
</odoo>
